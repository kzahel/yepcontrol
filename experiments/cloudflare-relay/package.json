{
  "name": "@yepcontrol/cloudflare-proof",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir .local/bundle",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm build && tsx fcm-auth-test.ts && tsx fcm-test.ts && tsx fcm-runtime-test.ts && tsx flow-test.ts && tsx admission-test.ts && tsx phone-invitation-test.ts && tsx test.ts && pnpm build:import && tsx migration-test.ts",
    "test:live": "tsx live-test.ts",
    "build:import": "wrangler deploy --dry-run --config migration-wrangler.jsonc --outdir .local/migration-bundle"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@types/node": "22.19.15",
    "@types/ws": "8.18.1",
    "miniflare": "5.20261006.1-alpha",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.149.0",
    "ws": "8.22.0"
  },
  "license": "MIT",
  "dependencies": {
    "jose": "6.2.13"
  }
}
