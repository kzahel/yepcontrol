{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "protocol/src",
    "protocol/test",
    "web/src",
    "web/test",
    "scripts",
    "relay/src",
    "relay/test",
    "client/src",
    "client/test",
    "cli/src",
    "cli/test"
  ]
}
