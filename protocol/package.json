{
  "name": "@remote/protocol",
  "private": true,
  "type": "module",
  "exports": {
    "./phone-invitation": {
      "types": "./dist/phone-invitation.d.ts",
      "import": "./dist/phone-invitation.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./enrollment": {
      "types": "./dist/enrollment.d.ts",
      "import": "./dist/enrollment.js"
    },
    "./features": {
      "types": "./dist/features.d.ts",
      "import": "./dist/features.js"
    },
    "./control": {
      "types": "./dist/control.d.ts",
      "import": "./dist/control.js"
    },
    "./framing": {
      "types": "./dist/framing.d.ts",
      "import": "./dist/framing.js"
    },
    "./device": {
      "types": "./dist/device.d.ts",
      "import": "./dist/device.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT"
}
